# Copiaza acest fisier in .env si completeaza datele.

# --- Email (ex. Gmail: foloseste o "App password", nu parola contului) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa.ta@gmail.com
SMTP_PASSWORD=parola-de-aplicatie
# SMTP_FROM=Secret Santa <adresa.ta@gmail.com>

# --- SMS prin Twilio (doar daca ai participanti cu numar de telefon) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890
